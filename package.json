{
  "name": "@csi-foxbyte/Regensburg_DigitalerEnergieZwilling_OfflineEnrichment",
  "version": "0.9.2",
  "packageManager": "pnpm@11.3.0",
  "description": "Offline CityJSON enrichment for building geometry metrics and digitalEnergyTwin attributes.",
  "type": "module",
  "scripts": {
    "test": "node --test --import tsx",
    "test:e2e:docker": "RUN_DOCKER_E2E=1 node --test --import tsx test/docker-e2e.test.ts",
    "build": "pnpm run lint && pnpm run test && tsdown",
    "lint": "tsc --noEmit",
    "prepack": "pnpm run build",
    "sbom": "node scripts/generate-sbom.mjs",
    "docs:api": "typedoc --options typedoc.json",
    "docs": "pnpm run docs:api"
  },
  "keywords": [
    "cityjson",
    "citygml",
    "energy",
    "digital",
    "twin"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "publint": "^0.3.18",
    "tsdown": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "proj4": "^2.20.3",
    "proj4-list": "^1.0.4",
    "tiny-glob": "^0.2.9",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0"
  }
}
